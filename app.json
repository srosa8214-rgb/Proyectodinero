{
  "expo": {
    "name": "Mi Dinero",
    "slug": "mi-dinero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "midinero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
      "android": {
  "package": "com.srosa8214.midinero",
  "versionCode": 1
},
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
